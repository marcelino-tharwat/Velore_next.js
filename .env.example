# Copy to `.env.local` and adjust. Do not commit `.env.local`.

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=01282e27872a23c1fedebe0c47ac200191d9d74ac4cde14476afeb3742eea571

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Registration ---
# true = auto-verify new users (local dev). false = require email link before login.
MOCK_EMAIL_VERIFICATION=true

# --- Admin seed (npm run seed:admin) ---
# Recommended local demo: primary account test20261; demo catalog adds test20262, test20263 (npm run seed:demo).
ADMIN_EMAIL=test20261@gmail.com
ADMIN_PASSWORD=Test@5050

# --- Stripe (test mode: use sk_test_ / pk_test_ from https://dashboard.stripe.com ) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from `stripe listen` (local) or Dashboard → Webhooks (production)
STRIPE_WEBHOOK_SECRET=

# --- Optional ---
# AUTH_DEBUG=1   # server logs for register / credentials / jwt (no passwords)
# SEED_DEBUG=1   # seed script extra logs
# ORDER_EMAIL_WEBHOOK_URL=    # Optional: POST JSON payload for order emails
# ORDER_EMAIL_WEBHOOK_TOKEN=  # Optional bearer token for the webhook endpoint
